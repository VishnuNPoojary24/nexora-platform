{
  "name": "nexora",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "npm run dev --workspace=apps/api",
    "build": "npm run build --workspace=apps/api && npm run build --workspace=apps/web",
    "test": "npm run test --workspace=apps/api && npm run test --workspace=apps/web",
    "lint": "npm run lint --workspace=apps/api && npm run lint --workspace=apps/web",
    "db:migrate": "npm run db:migrate --workspace=apps/api",
    "db:rollback": "npm run db:rollback --workspace=apps/api",
    "dev:compose": "docker compose -f docker-compose.dev.yml up --build",
    "dev:compose:down": "docker compose -f docker-compose.dev.yml down -v",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  },
  "private": "true",
  "workspaces": [
    "apps/web",
    "apps/api",
    "packages/types",
    "packages/api-client",
    "packages/config"
  ]
}
